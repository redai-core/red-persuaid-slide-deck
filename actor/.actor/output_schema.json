{
  "actorSpecification": 1,
  "title": "AI Search Audit Dataset",
  "description": "Audited AI search query results with citation links, domains, brand presence, and raw responses.",
  "fields": {
    "type": "object",
    "properties": {
      "platform": {
        "type": "string",
        "description": "Target AI engine evaluated ('chatgpt' or 'gemini')"
      },
      "query": {
        "type": "string",
        "description": "Consumer search query or prompt submitted to the engine"
      },
      "brand_name": {
        "type": "string",
        "description": "Target brand name evaluated"
      },
      "brand_domain": {
        "type": "string",
        "description": "Target brand domain evaluated"
      },
      "brand_cited": {
        "type": "boolean",
        "description": "Whether the target brand was mentioned in the generated AI response"
      },
      "brand_domain_cited": {
        "type": "boolean",
        "description": "Whether the brand's official domain was cited in the grounding sources"
      },
      "competitors_mentioned": {
        "type": "array",
        "description": "Competitor brands mentioned in the AI response",
        "items": {
          "type": "string"
        }
      },
      "citations": {
        "type": "array",
        "description": "Detailed citation objects including full URLs, root domains, titles, and brand domain flags",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "Full external citation URL"
            },
            "domain": {
              "type": "string",
              "description": "Root domain of the citation"
            },
            "title": {
              "type": "string",
              "description": "Page or source title if available"
            },
            "snippet": {
              "type": "string",
              "description": "Grounding snippet if available"
            },
            "position": {
              "type": "integer",
              "description": "1-based order of citation occurrence"
            },
            "is_brand_domain": {
              "type": "boolean",
              "description": "True if domain matches the target brand domain"
            }
          }
        }
      },
      "citation_domains": {
        "type": "array",
        "description": "List of unique root domains cited by the engine",
        "items": {
          "type": "string"
        }
      },
      "raw_response_text": {
        "type": "string",
        "description": "Full raw markdown response generated by the AI engine"
      },
      "response_length": {
        "type": "integer",
        "description": "Character count of the raw response text"
      },
      "duration_seconds": {
        "type": "number",
        "description": "Execution time in seconds to audit the query"
      },
      "timestamp": {
        "type": "string",
        "description": "UTC ISO timestamp when the audit finished"
      },
      "error": {
        "type": "string",
        "description": "Error message if the audit query failed"
      }
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": [
          "platform",
          "query",
          "brand_cited",
          "brand_domain_cited",
          "citation_domains",
          "response_length",
          "duration_seconds"
        ]
      },
      "display": {
        "component": "table",
        "columns": {
          "platform": {
            "label": "Platform",
            "format": "text"
          },
          "query": {
            "label": "Search Query",
            "format": "text"
          },
          "brand_cited": {
            "label": "Brand Mentioned",
            "format": "boolean"
          },
          "brand_domain_cited": {
            "label": "Domain Cited",
            "format": "boolean"
          },
          "citation_domains": {
            "label": "Citation Domains",
            "format": "array"
          },
          "response_length": {
            "label": "Length (chars)",
            "format": "number"
          },
          "duration_seconds": {
            "label": "Duration (s)",
            "format": "number"
          }
        }
      }
    },
    "citations": {
      "title": "Citations & URLs",
      "transformation": {
        "fields": [
          "query",
          "brand_name",
          "brand_domain",
          "citations",
          "citation_domains"
        ]
      },
      "display": {
        "component": "table",
        "columns": {
          "query": {
            "label": "Query",
            "format": "text"
          },
          "citations": {
            "label": "Citations",
            "format": "array"
          },
          "citation_domains": {
            "label": "Citation Domains",
            "format": "array"
          }
        }
      }
    }
  }
}
